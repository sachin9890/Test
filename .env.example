# Public-facing Express API (bind and expose this remotely, behind HTTPS)
PORT=3000
HOST=0.0.0.0

# Required. Bearer token clients must send as: Authorization: Bearer <token>
API_TOKEN=change-me

# Embedded OpenCode server (kept private to this host, never expose directly)
OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_MODEL=

# The project OpenCode works on. REPO_DIR must already be a git clone with
# at least one commit. Each session gets its own worktree under WORKTREES_DIR.
REPO_DIR=./repo
WORKTREES_DIR=./worktrees
