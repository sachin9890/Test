# Public-facing Express API (bind and expose this remotely, behind HTTPS)
PORT=3000
HOST=0.0.0.0

# Required. Bearer token clients must send as: Authorization: Bearer <token>
API_TOKEN=change-me

# Embedded OpenCode server (kept private to this host, never expose directly)
OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_MODEL=
# How long to wait for OpenCode's own server process to become ready. Raise this if
# startup is slow (e.g. a restricted network delays its model-catalog refresh).
OPENCODE_STARTUP_TIMEOUT_MS=30000

# Projects are added from the UI (or POST /api/projects) by giving a repo URL
# (optionally with a GitHub PAT for private repos) — this app clones them here.
# Each session then gets its own worktree under WORKTREES_DIR.
PROJECTS_DIR=./projects
WORKTREES_DIR=./worktrees

# Where project metadata (repo URL, branch, PAT) is persisted. Kept out of git and
# written with 0600 permissions; PATs are never returned by any API response.
DATA_DIR=./data
